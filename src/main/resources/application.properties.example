spring.application.name=CrediTrack

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/creditrack?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_DATABASE_PASSWORD_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# JWT Configuration (Generate a 256-bit secret key for production)
jwt.secret=YOUR_BASE64_JWT_SECRET_KEY_HERE
jwt.expiration=86400000
